# The image only needs backend/ and machine-learning/; everything below is
# either deployed elsewhere (frontend), too large (datasets, the second
# checkpoint), or local state that must not leak into a published image.
frontend/
data/
docs/
logs/
.venv/
.git/
.github/
.commandcode/

# Training artifacts. Only the EfficientNet-B0 run is served; Xception is 81 MB
# of weights the backend never loads.
machine-learning/runs/
machine-learning/checkpoints/xception_*

# Local secrets and runtime state — the Space supplies these as env vars.
backend/.env
backend/app.db
backend/uploads/

**/__pycache__/
*.py[cod]
