<mxfile host="drawio-mcp"><diagram id="upload-pipeline" name="Upload pipeline"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Inference pipeline for one uploaded video" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="a" value="Video file&lt;br&gt;&lt;small&gt;.mp4 / .avi / .mov&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="b" value="Sample frames&lt;br&gt;&lt;small&gt;~5 fps, max 100&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="c" value="MTCNN&lt;br&gt;&lt;small&gt;largest face, conf 0.95&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="d" value="Face crop&lt;br&gt;&lt;small&gt;v1: 20px margin&lt;br&gt;v2: aligned 1.4x box&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="150" height="80" as="geometry"/></mxCell><mxCell id="e" value="Batched forward pass&lt;br&gt;&lt;small&gt;224x224, fake prob per frame&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="150" height="70" as="geometry"/></mxCell><mxCell id="f" value="Mean of frames&lt;br&gt;&lt;small&gt;video score&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="205" width="150" height="60" as="geometry"/></mxCell><mxCell id="g" value="Risk bands&lt;br&gt;&lt;small&gt;&amp;lt;0.4 REAL&lt;br&gt;0.4 to 0.7 SUSPICIOUS&lt;br&gt;&amp;gt;0.7 HIGH_RISK&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="150" height="90" as="geometry"/></mxCell><mxCell id="h" value="Suspicious region&lt;br&gt;&lt;small&gt;longest run of frames &amp;gt;= 0.7, min 3&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="150" height="70" as="geometry"/></mxCell><mxCell id="i" value="Store + return&lt;br&gt;&lt;small&gt;PostgreSQL row, JSON reply&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="170" height="60" as="geometry"/></mxCell><mxCell id="x" value="No face anywhere&lt;br&gt;&lt;small&gt;422 error&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="per-frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;" edge="1" parent="1" source="e" target="h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="g" target="i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="0 crops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#B20000;labelBackgroundColor=default;" edge="1" parent="1" source="d" target="x"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
