# Public hostname. Its DNS A record must point at this server before the first
# start, or Caddy cannot obtain a certificate.
DOMAIN=deepguard.muditgarg.xyz

# Neon (or any Postgres) connection string.
NEON_DB_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

MAX_UPLOAD_MB=100

# Clerk (dashboard -> API keys). Use the production instance's keys here; the
# publishable key is baked into the frontend at build time.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
