# Public hostname. Its DNS A record must point at this server before the first
# start, or Caddy cannot obtain a certificate.
DOMAIN=deepguard.muditgarg.xyz

# Neon (or any Postgres) connection string.
NEON_DB_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

MAX_UPLOAD_MB=100

# Clerk (dashboard -> API keys). Use the production instance's publishable key;
# the backend hands it to the pages through /api/config.
CLERK_PUBLISHABLE_KEY=pk_live_...

# Admin login (not a Clerk account). Leave empty to turn it off. Use a long
# random password: this form is reachable by anyone on the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
