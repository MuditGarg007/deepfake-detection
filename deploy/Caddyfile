# Site block for the host Caddy (/etc/caddy/Caddyfile), which also serves other
# projects. Append it there, then `caddy validate --config /etc/caddy/Caddyfile`
# before `systemctl reload caddy`.
deepguard.muditgarg.xyz {
	encode zstd gzip

	# The backend serves both the pages and the /api routes.
	request_body {
		max_size 110MB
	}
	reverse_proxy 127.0.0.1:8100
}
