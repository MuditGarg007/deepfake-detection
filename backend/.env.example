# Neon connection string (DATABASE_URL is accepted as an alias). Required.
NEON_DB_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Checkpoint directory. Point this at one run; the parent directory also works
# (the newest run inside it is loaded).
MODEL_DIR=machine-learning/checkpoints/efficientnet_b0_20260901_204509

UPLOAD_DIR=uploads
RISK_SUSPICIOUS=0.4
RISK_HIGH=0.7
FRAME_THRESHOLD=0.7
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
