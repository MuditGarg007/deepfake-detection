# Neon connection string (DATABASE_URL is accepted as an alias). Required.
NEON_DB_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Checkpoint directory. Point this at one run; the parent directory also works
# (the newest run inside it is loaded).
MODEL_DIR=machine-learning/checkpoints/efficientnet_b0_20260901_204509

UPLOAD_DIR=uploads
RISK_SUSPICIOUS=0.4
RISK_HIGH=0.7
FRAME_THRESHOLD=0.7
MAX_UPLOAD_MB=200

# Live screen share. The entry thresholds above are shared with the upload
# path; RISK_HYSTERESIS is how far the smoothed score has to fall back before
# the live badge leaves a state.
RISK_HYSTERESIS=0.1
LIVE_EMA_ALPHA=0.2
LIVE_HISTORY_FRAMES=120
LIVE_DETECT_EVERY=5
LIVE_SESSION_TTL=300
LIVE_TIMELINE_MAX=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
