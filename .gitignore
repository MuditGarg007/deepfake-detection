# Python
__pycache__/
*.py[cod]
.venv/

# Backend runtime
backend/.env
backend/uploads/

# ML data + artifacts
data/
# `checkpoints/*` (not `checkpoints/`) so git still descends into the directory
# and can un-ignore the served run below.
machine-learning/checkpoints/*
# ...but the checkpoint the deployed backend loads ships with the repo, since
# Hugging Face builds the Space from git. Tracked with LFS (see .gitattributes).
!machine-learning/checkpoints/efficientnet_b0_20260901_204509/
# Note: `runs/*` (not `runs/`) so git still descends into the directory and
# can un-ignore the file below.
machine-learning/runs/*
# ...but the reports and the measurements the handoff cites are deliverables:
# without them the numbers in docs/ml-v2-handoff.md cannot be checked against
# anything. Frame-level score dumps stay ignored — they are megabytes and
# regenerable from a checkpoint.
!machine-learning/runs/comparison.md
!machine-learning/runs/v2_comparison.md
!machine-learning/runs/ranking.txt
!machine-learning/runs/temporal_v2.csv
!machine-learning/runs/video_aggregation.csv
!machine-learning/runs/sharpness_vs_score.csv
*.log

backend/app.db

# Next.js frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
